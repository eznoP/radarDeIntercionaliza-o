# ============================================================================
# Radar de Internacionalização — variáveis de ambiente
# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# (Project Settings > API)
# ============================================================================

# URL do projeto, ex.: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon / publishable) — pode ir para o navegador
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta (service_role) — NUNCA exponha no cliente; só no servidor
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada em metadata/OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
